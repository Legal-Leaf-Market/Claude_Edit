# ---------------------------------------------------------------------------
# Gear Avail environment
#
# Copy to .env.local for development. Nothing here is required except
# DATABASE_URL: every integration degrades to a logged no-op when its
# credentials are absent, so the app runs end to end before any of the gated
# partner approvals land.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:5432/gearavail
SITE_URL=http://localhost:3000

# Optional. Enables the BullMQ workers. Without it, ingestion runs through the
# /api/cron/* routes instead and the queue layer stays dormant.
REDIS_URL=redis://localhost:6379

# --- eBay Buy Feed API (Limited Release, gated on EPN approval) --------------
# Defaults to SANDBOX. Only change this once a production keyset is approved.
#   sandbox:    https://api.sandbox.ebay.com/buy/feed/v1_beta
#   production: https://api.ebay.com/buy/feed/v1_beta
EBAY_FEED_BASE_URL=https://api.sandbox.ebay.com/buy/feed/v1_beta
EBAY_OAUTH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
# Passing affiliate context is what populates itemAffiliateWebUrl in the feed.
# Without it every eBay row lands with a null affiliate_url and the /go gateway
# falls back to the raw listing URL.
EBAY_AFFILIATE_CAMPAIGN_ID=
# 619 = Musical Instruments & Gear (L1, EBAY_US). Comma separated.
# Re-verify with the Taxonomy API at build time; eBay reshuffles categories.
EBAY_CATEGORY_IDS=619
# Bytes per Range request. eBay caps a single chunk at 100 MB (104857600).
EBAY_FEED_CHUNK_BYTES=10485760
EBAY_DAILY_CALL_BUDGET=10000

# --- Awin (Reverb + Gear4music: monetisation and catalogue) -------------------
AWIN_PUBLISHER_ID=
# Reverb's Awin advertiser id is 67144 ("Reverb (US)"), confirmed against Awin's
# advertiser directory on 10 Aug 2026. Set it to that unless the dashboard
# disagrees, in which case trust the dashboard.
AWIN_REVERB_MERCHANT_ID=67144
# Reverb's product datafeed URL, from the Awin publisher dashboard.
#
# The feed is CONFIRMED to exist: advertiser 67144 reports feedEnabled=yes and
# productReporting=yes, with a 30-day cookie, a 100% approval rate and green
# payment status, live since Nov 2023. So this being empty is now a missing URL
# rather than a missing source, and the only step left is joining the programme
# and copying the datafeed link out of the dashboard.
#
# lib/ingestion/reverb-awin.ts is ready for it: 21 tests green, gzip sniffed
# from the magic bytes whether or not the URL ends .gz, delimiter detected, and
# column names bound by alias so Awin's mixed-case headers do not matter. It
# still no-ops while this is unset and still never falls back to the Reverb API
# or to scraping, which section 2 of CLAUDE.md forbids outright.
AWIN_REVERB_FEED_URL=

# Gear4music runs on the same Awin account, with its own programme id and feed.
# Confirmed in the same directory check: advertiser 1117, feedEnabled=yes,
# 3.5-5% commission, 30-day cookie, 92.6% approval. The four regional
# programmes are IE 27588, FR 27586, DK 27600 and PL 27598, matching the five
# domains isGear4MusicProductUrl already recognises.
AWIN_GEAR4MUSIC_MERCHANT_ID=1117
AWIN_GEAR4MUSIC_FEED_URL=

# --- CJ Affiliate (zZounds, Full Compass Systems, Pineville Music) ----------
# Each is a separate CJ advertiser program with its own feed URL. Leave UNSET
# unless confirmed in the CJ Affiliate account dashboard. Each worker no-ops
# when its feed is absent and never falls back to scraping.
CJ_ZZOUNDS_FEED_URL=
CJ_FULLCOMPASS_FEED_URL=
CJ_PINEVILLEMUSIC_FEED_URL=

# --- Impact.com (Anderton's) -------------------------------------------------
# Programme APPROVED 11 Aug 2026. Commission is 4% on a named brand list, NOT
# on the catalogue (see CLAUDE.md section 1). That list must never become an
# ingestion filter or a ranking input.
#
# Impact delivers catalogues by FTP DROP, not over an authenticated HTTPS URL
# the way Awin, CJ and LinkConnector do: one directory per advertiser on
# products.impact.com. Host and path have real defaults, so hasAndertonsFeed
# gates on the credential pair instead.
#
# IMPACT_ANDERTONS_FTP_PASSWORD is a REAL CREDENTIAL, unlike most values in
# this file. Keep it in the environment, never in a committed file, and rotate
# it if it is ever pasted anywhere it should not be.
#
# No ingestion module exists yet: Impact's product-feed schema is configured
# per advertiser rather than fixed, so the column headers have to be read off
# the real file before a row-normaliser can be written. Note also that this job
# cannot run from a Vercel cron route (FTP needs a control connection plus
# passive data ports, which a serverless function cannot hold open); it belongs
# on the BullMQ worker.
IMPACT_ANDERTONS_FTP_HOST=products.impact.com
IMPACT_ANDERTONS_FTP_USER=
IMPACT_ANDERTONS_FTP_PASSWORD=
IMPACT_ANDERTONS_FTP_PATH=/Andertons-Music-Company/

# --- Small independent Shopify sellers (GoAffPro or similar) ----------------
# Catalogue ingestion works with no credentials at all; each store's public
# products.json is read directly, verified per store against its own
# agents.md "Read-Only Browsing" section first. These vars only carry this
# publisher's actual referral code so /go can build a real affiliate link
# instead of falling back to the raw URL.
GOAFFPRO_FOLKCRAFT_REF_PARAM=
GOAFFPRO_FOLKCRAFT_REF_CODE=
GOAFFPRO_ACOUSTICGUITAR_REF_PARAM=
GOAFFPRO_ACOUSTICGUITAR_REF_CODE=
GOAFFPRO_JAMSTIK_REF_PARAM=
GOAFFPRO_JAMSTIK_REF_CODE=
# Jackson Audio's approved referral link is jackson.audio/?ref=<code>, so the
# parameter defaults to "ref" in code; only the actual code needs to be set.
GOAFFPRO_JACKSONAUDIO_REF_CODE=
# Sells digital impulse response packs, not physical gear; included anyway on
# explicit request. Condition/shipping fields carry no real meaning here.
GOAFFPRO_EMINENCEDIGITAL_REF_CODE=
GOAFFPRO_HAZEGUITAR_REF_CODE=
GOAFFPRO_EARTGUITAR_REF_CODE=
# Pending GoAffPro approval as of writing; wired up ahead of that since an
# unset code just means a null affiliate_url until it's confirmed.
GOAFFPRO_PLAYWITHAUTHORITY_REF_CODE=
GOAFFPRO_PURESMUSIC_REF_CODE=
GOAFFPRO_EASONMUSICSTORE_REF_CODE=
# Squaver runs on WooCommerce (see lib/ingestion/woocommerce-storefront.ts),
# a weaker compliance basis than the Shopify agents.md sources above; built on
# explicit request despite that.
GOAFFPRO_SQUAVER_REF_CODE=
GOAFFPRO_GOKALIMBA_REF_CODE=

# --- LinkConnector (Sweetwater catalogue, if a feed exists) ------------------
# Sweetwater's affiliate program runs on LinkConnector. Leave UNSET unless a
# real product datafeed is confirmed in the LinkConnector affiliate dashboard.
# The Sweetwater worker no-ops when it is absent and never falls back to
# scraping sweetwater.com or its search index.
LINKCONNECTOR_SWEETWATER_FEED_URL=

# --- Typesense (optional; Postgres full-text is the fallback) ----------------
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_ONLY_KEY=
TYPESENSE_COLLECTION=listings

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Adds "Continue with Google" to sign-in/sign-up. Unset just means
# email and password only; nothing else on the site depends on this.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Alerts -----------------------------------------------------------------
RESEND_API_KEY=
SITE_FROM_EMAIL=alerts@gearavail.app
DISCORD_WEBHOOK_URL=

# --- Merchant leads (/list-your-shop) ----------------------------------------
# Reuses RESEND_API_KEY and DISCORD_WEBHOOK_URL above; this only sets where the
# email notification goes. Unset means leads still land in the database (the
# durable record), just with no notification sent.
LEADS_NOTIFY_EMAIL=

# --- Cron -------------------------------------------------------------------
# Fails CLOSED. Unset makes every /api/cron/* route return 503; a wrong bearer
# returns 401. Never deploy without this set.
CRON_SECRET=

# --- Admin (/admin/operating-model) ------------------------------------------
# Fails CLOSED. Unset means nobody can sign in, ever, rather than the page
# quietly being unprotected. A long random string; also signs the session
# cookie, so rotating it signs everyone out. openssl rand -base64 32
ADMIN_PASSCODE=

# --- Instagram (homepage + footer follow strip) ------------------------------
# INSTAGRAM_HANDLE just controls the follow links and defaults to
# stompbox.world. INSTAGRAM_POST_URLS is a comma list of public post
# permalinks (https://www.instagram.com/p/.../) to embed via Instagram's own
# official embed.js; leave it UNSET to show a plain follow callout instead.
INSTAGRAM_HANDLE=stompbox.world
INSTAGRAM_POST_URLS=

# --- Ask (the Groq-backed assistant) -----------------------------------------
# Unset is a supported state: /api/ask answers 503 with a plain reason and the
# "Ask" button is not rendered at all, so an unconfigured deploy is simply
# missing one feature rather than showing a broken one.
#
# The assistant queries this site's own database through a fixed set of
# allowlisted tools (lib/ai/tools.ts). It never writes SQL, never gets a
# connection, and every tool is read-only, so the worst a prompt injection
# carried in a listing title can do is produce a wrong answer.
#
# GROQ_MODEL defaults to openai/gpt-oss-120b, which is where Groq's own
# deprecation notices point every retired model (kimi-k2-instruct in March
# 2026, qwen3-32b and llama-4-scout in June 2026) and which supports the tool
# calling this depends on. Override it rather than shipping a code change when
# that list moves again.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Per-IP question budget per FIXED CLOCK HOUR (resets on the hour, not a rolling
# window). Generous for a person, useless for a scraper. Shared across instances
# when REDIS_URL is set, per-process otherwise.
GROQ_HOURLY_LIMIT_PER_IP=30
